{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run BranchNotes Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "compile"
    },
    {
      "name": "Run Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--extensionTestsPath=${workspaceFolder}/out-test/test/suite"],
      "outFiles": ["${workspaceFolder}/out/**/*.js", "${workspaceFolder}/out-test/**/*.js"],
      "preLaunchTask": "test:compile"
    }
  ]
}
